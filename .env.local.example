# Copy this file to .env.local for local dev, and set the same
# keys/values in your Vercel project's Environment Variables when deploying.

# ---- Login (who's allowed in the door) ----
# From Google Cloud Console -> APIs & Services -> Credentials
# (create an "OAuth client ID" of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32   (or use generate-secret.vercel.app/32)
NEXTAUTH_SECRET=

# The full deployed URL, e.g. https://bills.vercel.app
# For local dev use http://localhost:3000
NEXTAUTH_URL=

# Comma-separated list of the ONLY emails allowed to sign in.
ALLOWED_EMAILS=neel@cargar.in,colleague1@cargar.in,colleague2@cargar.in

# ---- Bill reading (free tier) ----
# From https://aistudio.google.com/apikey  (no credit card needed for free tier)
GEMINI_API_KEY=
# Leave as-is unless you hit errors - see README for how to pick a different model.
GEMINI_MODEL=gemini-flash-latest

# ---- Where the data goes (a shared Google Sheet) ----
# From the JSON key file you download when you create a Service Account
# in Google Cloud Console -> IAM & Admin -> Service Accounts.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole "private_key" value from that JSON file, including
# -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY----- and the \n's.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The long ID in your sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=
# Only change these if you renamed the tab or it isn't the first tab.
GOOGLE_SHEET_TAB_NAME=Sheet1
GOOGLE_SHEET_TAB_GID=0

# Optional: the full sheet URL, so the app can show an "Open Google Sheet"
# button. Must start with NEXT_PUBLIC_ so the browser can see it.
NEXT_PUBLIC_GOOGLE_SHEET_URL=
